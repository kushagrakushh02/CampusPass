<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#1b1b4b">
  <title>${fn:escapeXml(empty pageTitle ? 'Events' : pageTitle)} - CampusPass</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="${ctx}/assets/css/style.css">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%8E%9F%EF%B8%8F%3C/text%3E%3C/svg%3E">
</head>
<body>
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="i-pin" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></symbol>
  <symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></symbol>
  <symbol id="i-cal" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></symbol>
  <symbol id="i-ticket" viewBox="0 0 24 24"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2z"/><path d="M13 5v2M13 11v2M13 17v2"/></symbol>
  <symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.3-4.3"/></symbol>
  <symbol id="i-check" viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></symbol>
  <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
  <symbol id="i-edit" viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></symbol>
  <symbol id="i-trash" viewBox="0 0 24 24"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6M10 11v6M14 11v6"/></symbol>
  <symbol id="i-users" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8"/></symbol>
  <symbol id="i-download" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></symbol>
  <symbol id="i-print" viewBox="0 0 24 24"><path d="M6 9V2h12v7M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></symbol>
  <symbol id="i-back" viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></symbol>
  <symbol id="i-eye" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"/><circle cx="12" cy="12" r="3"/></symbol>
</svg>

<header class="nav">
  <div class="container nav-inner">
    <a class="brand" href="${ctx}/">
      <span class="brand-mark" aria-hidden="true"></span>CampusPass
    </a>
    <button class="nav-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="nav-menu">
      <span></span><span></span><span></span>
    </button>
    <nav class="nav-menu" id="nav-menu" aria-label="Main">
      <a href="${ctx}/" class="${navActive == 'events' ? 'active' : ''}">Events</a>
      <c:if test="${not empty sessionScope.user}">
        <a href="${ctx}/my-bookings" class="${navActive == 'tickets' ? 'active' : ''}">My tickets</a>
      </c:if>
      <c:if test="${not empty sessionScope.user and sessionScope.user.admin}">
        <a href="${ctx}/admin" class="${navActive == 'admin' ? 'active' : ''}">Organiser</a>
      </c:if>
      <span class="nav-spacer"></span>
      <c:choose>
        <c:when test="${not empty sessionScope.user}">
          <span class="who"><span class="avatar" aria-hidden="true">${fn:escapeXml(sessionScope.user.initial)}</span>${fn:escapeXml(sessionScope.user.name)}</span>
          <form method="post" action="${ctx}/logout" class="inline">
            <input type="hidden" name="_csrf" value="${sessionScope.csrf}">
            <button type="submit" class="btn btn-quiet btn-sm">Log out</button>
          </form>
        </c:when>
        <c:otherwise>
          <a href="${ctx}/login" class="${navActive == 'login' ? 'active' : ''}">Log in</a>
          <a href="${ctx}/register" class="btn btn-gold btn-sm">Create account</a>
        </c:otherwise>
      </c:choose>
    </nav>
  </div>
</header>

<c:if test="${not empty sessionScope.flashMsg}">
  <div class="toast toast-${sessionScope.flashType == 'error' ? 'error' : 'success'}" role="status">
    <span>${fn:escapeXml(sessionScope.flashMsg)}</span>
    <button type="button" class="toast-x" aria-label="Dismiss">&times;</button>
  </div>
  <c:remove var="flashMsg" scope="session"/>
  <c:remove var="flashType" scope="session"/>
</c:if>

<main>
